<idea-plugin>
    <id>com.cloudtoolkit.ecsdeploy</id>
    <name>Cloud Toolkit - ECS Deploy</name>
    <vendor>cloud-toolkit</vendor>
    <description><![CDATA[
        Cloud Toolkit ECS Deploy builds a Java artifact in IntelliJ IDEA, uploads it to an ECS instance over SFTP, restarts the service over SSH, and streams the deployment log into the Run tool window. All host, credential, tag and command data is stored in <code>~/.cloudidea/cloudtoolkit.db</code> (SQLite), reusing the database's existing tables.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <idea-version since-build="262"/>

    <resource-bundle>messages.EcsDeployBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.cloudtoolkit.ecsdeploy.settings.EcsConnectionsService"/>
        <configurationType implementation="com.cloudtoolkit.ecsdeploy.ui.EcsDeployConfigurationType"/>
        <notificationGroup id="cloud-toolkit.ecs.deploy" displayType="BALLOON" key="notification.group"/>
        <applicationConfigurable instance="com.cloudtoolkit.ecsdeploy.settings.EcsConnectionsConfigurable"
                                 id="cloud-toolkit.ecs.connections"
                                 displayName="Cloud Toolkit"/>
        <applicationConfigurable instance="com.cloudtoolkit.ecsdeploy.settings.TagsConfigurable"
                                 id="cloud-toolkit.ecs.tags"
                                 parentId="cloud-toolkit.ecs.connections"
                                 displayName="标签 Tags"/>
        <applicationConfigurable instance="com.cloudtoolkit.ecsdeploy.settings.ProfileConfigurable"
                                 id="cloud-toolkit.ecs.profile"
                                 parentId="cloud-toolkit.ecs.connections"
                                 displayName="Profile 配置"/>
        <toolWindow id="Cloud Toolkit View"
                    anchor="bottom"
                    factoryClass="com.cloudtoolkit.ecsdeploy.ui.CloudToolkitToolWindow" canCloseContents="true"/>
    </extensions>
</idea-plugin>
